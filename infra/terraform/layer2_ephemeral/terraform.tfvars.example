# Copy to terraform.tfvars and adjust. layer1_state_bucket is required so this
# stack can read layer1's outputs (ECR repo, secret ARN, CloudFront domain).

layer1_state_bucket = "CHANGE_ME-terraform-state"
image_tag           = "latest"

# Cost/scale knobs (defaults are the cheap single-AZ demo). Flip one boolean for
# the full production-grade shape (Multi-AZ RDS + autoscaling + Redis):
high_availability = false

# db_instance_class = "db.t4g.small"
# ecs_task_cpu      = 512
# ecs_task_memory   = 1024
# api_desired_count = 1

# alert_email = "you@example.com"   # CloudWatch alarm notifications

# Custom domain → HTTPS on the API. Required for a working app, not merely
# recommended: without it the ALB is plaintext HTTP, the browser blocks an HTTPS
# page from calling it as mixed content, and the cross-site refresh cookie cannot
# be set at all (SameSite=None is only honoured with Secure, which needs TLS).
# Requires a Route53 hosted zone you own. Applying without it is refused unless
# allow_insecure_http is set — see the variable for what that mode can and can't do.
api_domain_name  = "api.example.com"
hosted_zone_name = "example.com"

# allow_insecure_http = true   # infrastructure without a working login
