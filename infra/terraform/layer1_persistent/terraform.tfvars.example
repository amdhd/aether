# Copy to terraform.tfvars. Custom frontend domain on CloudFront (optional).
# Requires a Route53 public hosted zone you own (create it once, out of band).
# Leave both empty to use the default *.cloudfront.net HTTPS URL.

# frontend_domain_name = "ahmadhadi.info"   # apex; www is added automatically
# hosted_zone_name     = "ahmadhadi.info"
# budget_alert_email   = "you@example.com"

# Origin the SPA calls the API on — the same host as layer2's api_domain_name.
# Named in the CSP's connect-src, which is what stops an injected script sending
# the user's data somewhere else. Unset, connect-src has to fall back to allowing
# any HTTPS host, so set it.
# api_origin = "https://api.ahmadhadi.info"

# GitHub Actions deploy role (OIDC). Set to this repo to create it, then copy the
# github_deploy_role_arn output into the repo variable AWS_DEPLOY_ROLE_ARN.
# github_repository           = "owner/name"
# create_github_oidc_provider = false # if the account already has one
